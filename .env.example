# Optional live LLM mode. The gallery and replay need no credentials.
# This is a reference template; set these in your shell or hosting dashboard.
OPENAI_API_KEY=
RE4_API_BASE=https://api.openai.com/v1
RE4_MODEL=
RE4_CONSULTANT_MODEL=
RE4_PROGRAMMER_MODEL=
RE4_REVIEWER_MODEL=

# Enable only on a private host where you intend to execute generated Python.
RE4_ENABLE_LIVE_EXECUTION=0
